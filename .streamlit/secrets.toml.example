# Copie este arquivo para .streamlit/secrets.toml e nunca envie o arquivo real
# para o GitHub. No Streamlit Cloud, use Manage app > Settings > Secrets.
FIREBASE_WEB_API_KEY = "cole_sua_chave_web_aqui"

# Copie os valores correspondentes do arquivo local secrets/key.json.
[firebase_service_account]
type = "service_account"
project_id = "seu-project-id"
private_key_id = "seu-private-key-id"
private_key = """-----BEGIN PRIVATE KEY-----
cole_sua_chave_privada_aqui
-----END PRIVATE KEY-----
"""
client_email = "firebase-adminsdk@seu-project-id.iam.gserviceaccount.com"
client_id = "seu-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40seu-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
